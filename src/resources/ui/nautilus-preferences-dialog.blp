using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog preferences_dialog {
  search-enabled: true;

  Adw.PreferencesPage {
    title: _("General");

    Adw.PreferencesGroup {
      title: _("General");

      Adw.SwitchRow sort_folders_first_row {
        title: _("Sort _Folders Before Files");
        use-underline: true;
      }

      Adw.SwitchRow use_tree_view_row {
        title: _("_Expandable Folders in List View");
        use-underline: true;
      }

      Adw.ActionRow open_action_row {
        title: _("_Action to Open Items");
        use-underline: true;

        [suffix]
        Adw.ToggleGroup open_action_toggle_group {
          valign: center;

          Adw.Toggle single_click_toggle {
            label: _("Single-Click");
            name: "single";
          }

          Adw.Toggle double_click_toggle {
            label: _("Double-Click");
            name: "double";
          }
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Optional Context Menu Actions");
      description: _(
        "Show more actions in the menus. Keyboard shortcuts can be used even if the actions are not shown."
      );

      Adw.SwitchRow show_create_link_row {
        title: _("Create _Link");
        use-underline: true;
      }

      Adw.SwitchRow show_delete_permanently_row {
        title: _("_Delete Permanently");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Performance");
      description: _(
        "These features may cause slowdowns and excess network usage, especially when browsing files outside this device, such as on a remote server."
      );

      Adw.ComboRow search_recursive_row {
        title: _("Search in Su_bfolders");
        use-underline: true;
      }

      Adw.ComboRow thumbnails_row {
        title: _("Show _Thumbnails");
        use-underline: true;
      }

      Adw.ComboRow count_row {
        title: _("_Count Number of Files in Folders");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Date and Time Format");
      description: _("Choose how dates and times are displayed in list and grid views.");

      Adw.ActionRow date_format_simple_row {
        title: _("_Simple");
        use-underline: true;

        [prefix]
        CheckButton date_format_simple_button {
          valign: center;
          action-name: "preferences.date-time-format";
          action-target: "'simple'";
        }

        activatable-widget: date_format_simple_button;
      }

      Adw.ActionRow date_format_detailed_row {
        title: _("Deta_iled");
        use-underline: true;

        [prefix]
        CheckButton date_format_detailed_button {
          group: date_format_simple_button;
          valign: center;
          action-name: "preferences.date-time-format";
          action-target: "'detailed'";
        }

        activatable-widget: date_format_detailed_button;
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Sidebar");

    Adw.PreferencesGroup {
      title: _("Sidebar Items");
      description: _("Choose which items are shown in the sidebar.");

      Adw.SwitchRow show_sidebar_trash_row {
        title: _("Show _Trash");
        use-underline: true;
      }

      Adw.SwitchRow show_sidebar_network_row {
        title: _("Show _Network Section");
        use-underline: true;
      }

      Adw.SwitchRow show_sidebar_volumes_row {
        title: _("Show _Volumes Section");
        use-underline: true;
      }

      Adw.SwitchRow show_unmounted_volumes_row {
        title: _("Show _Unmounted Volumes");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Volumes");
      description: _("Control how local volumes are displayed in the sidebar.");

      Adw.SwitchRow show_volume_sizes_row {
        title: _("Show Volume _Sizes");
        use-underline: true;
      }

      Adw.SwitchRow show_volume_usage_row {
        title: _("Show _Used Space");
        use-underline: true;
      }

      Adw.ComboRow usage_accent_row {
        title: _("Usage _Color");
        use-underline: true;
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Thumbnails");

    Adw.PreferencesGroup {
      title: _("Folder Previews");
      description: _("Show a preview composed of the items contained in folders.");

      Adw.SwitchRow folder_thumbnails_row {
        title: _("Enable _Folder Previews");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Thumbnail Formats");
      description: _("Choose which kinds of files can have a thumbnail.");

      Adw.SwitchRow video_thumbnails_row {
        title: _("_Video Files");
        use-underline: true;
      }

      Adw.SwitchRow pdf_thumbnails_row {
        title: _("_PDF Documents");
        use-underline: true;
      }

      Adw.SwitchRow office_thumbnails_row {
        title: _("_Office Documents");
        use-underline: true;
      }

      Adw.SwitchRow list_thumbnails_row {
        title: _("Show Thumbnails in the _List View");
        use-underline: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Preview Cache");

      Adw.SpinRow thumbnail_limit_row {
        title: _("Maximum File _Size");
        subtitle: _("Files larger than this size are not thumbnailed, in megabytes.");
        use-underline: true;
        digits: 0;
        adjustment: Adjustment {
          lower: 1;
          upper: 1024;
          step-increment: 1;
          page-increment: 10;
        };
      }

      Adw.ActionRow clear_thumbnail_cache_row {
        title: _("Clear Thumbnail _Cache");
        subtitle: _("Remove cached thumbnails so that they are generated again.");
        use-underline: true;
        activatable: false;

        [suffix]
        Button clear_thumbnail_cache_button {
          label: _("Clear");
          valign: center;
          styles [
            "destructive-action",
          ]
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Preview Panel");

      Adw.SwitchRow preview_panel_row {
        title: _("Show the _Preview Panel");
        subtitle: _("Display a large preview and details of the selected file next to the view.");
        use-underline: true;
      }
    }
  }
}
